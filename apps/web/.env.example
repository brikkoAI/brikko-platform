# --------------------------------------------------------------------
# Backend API base URL (для lib/api.ts)
#
# Поведение:
#   - НЕ задано или указывает на localhost:3000 → используем MSW (dev).
#   - Указано на реальный backend → запросы идут напрямую с credentials: 'include'.
#
# Switch backend mode:
NEXT_PUBLIC_API_BASE_URL=                                    # empty → MSW (dev)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1          # local backend
# NEXT_PUBLIC_API_BASE_URL=https://api.brikko.ru/v1         # production

# Frontend base URL — backend подставит его в verify-email/reset-password ссылки.
# Использует config.frontend_url на стороне gateway (см. voltari_gateway/email/client.py).
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# --------------------------------------------------------------------
# Auth middleware
# В MSW-режиме backend не выставляет реальный cookie (vlt_access),
# поэтому middleware на /app/* отключаем — иначе e2e ловят redirect-loop.
# Для e2e против real backend — оставь пустым (или 'false').
NEXT_PUBLIC_AUTH_MIDDLEWARE_DISABLED=true

# Brand toggles (single-source — см. lib/brand.ts; здесь только для build-time fallback)
NEXT_PUBLIC_BRAND_NAME=Brikko
NEXT_PUBLIC_BRAND_DOMAIN=brikko.ru

# Sentry (V2 — пустое в MVP)
# NEXT_PUBLIC_SENTRY_DSN=
