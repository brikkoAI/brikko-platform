{
  "name": "@voltari/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert integration",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --project=chromium e2e/01_landing_smoke.spec.ts e2e/02_signup_flow.spec.ts e2e/03_dashboard.spec.ts",
    "test:e2e:smoke:prod": "cross-env E2E_BASE_URL=https://brikko.ru playwright test --project=prod",
    "e2e": "npm run test:e2e:smoke",
    "test:e2e:integration": "E2E_REAL_BACKEND=true playwright test e2e/integration.spec.ts",
    "test:e2e:integration:win": "set E2E_REAL_BACKEND=true&& playwright test e2e/integration.spec.ts",
    "msw:init": "msw init public/ --save",
    "generate:types": "npx -y tsx scripts/generate-types.ts",
    "typecheck:contract": "tsc --noEmit && vitest run tests/schema-contract.test.ts"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "@sentry/nextjs": "^10.51.0",
    "@studio-freight/lenis": "^1.0.42",
    "@tanstack/react-query": "5.59.0",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "geist": "^1.7.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "ky": "1.7.2",
    "lucide-react": "0.451.0",
    "marked": "^18.0.3",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.0",
    "sonner": "1.5.0",
    "tailwind-merge": "2.5.2",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.48.0",
    "@tanstack/react-query-devtools": "5.59.0",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.18",
    "eslint-plugin-security": "^4.0.0",
    "jsdom": "25.0.1",
    "msw": "^2.4.9",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "tailwindcss": "3.4.13",
    "tsx": "^4.21.0",
    "typescript": "5.6.3",
    "vitest": "2.1.2"
  },
  "overrides": {
    "fast-uri": "^3.1.2"
  }
}
