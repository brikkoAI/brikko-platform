# --- Brand ---
BRAND_NAME=Brikko
BRAND_DOMAIN=brikko.local

# --- App ---
APP_ENV=local                   # local | test | development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ---
# postgres for production, sqlite+aiosqlite for local quick start
DATABASE_URL=postgresql+asyncpg://voltari:voltari@localhost:5432/voltari
# DATABASE_URL=sqlite+aiosqlite:///./voltari.db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Provider keys (server-side, NEVER ship to clients) ---

# OpenAI
OPENAI_API_KEY=sk-proj-CHANGEME
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT_SECONDS=60

# Google Gemini (uses google-genai SDK; AI Studio API key, not Vertex)
GOOGLE_API_KEY=
GOOGLE_TIMEOUT_SECONDS=60

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT_SECONDS=60

# Yandex Foundation Models (RU-legal*) — see README §reseller-OK
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_TIMEOUT_SECONDS=60

# Sber GigaChat (RU-legal*) — see README §reseller-OK
# SBER_AUTH_KEY is the base64 string from your Sber dev cabinet (Authorization Basic ...).
SBER_AUTH_KEY=
SBER_SCOPE=GIGACHAT_API_CORP    # GIGACHAT_API_CORP | GIGACHAT_API_PERS | GIGACHAT_API_B2B
SBER_TIMEOUT_SECONDS=60

# --- Crypto ---
# 32-byte base64-encoded Fernet key, generate via:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=PLEASE_GENERATE_AND_REPLACE
ENCRYPTION_KEY_ID=key-2026-04

# --- Auth cache ---
AUTH_CACHE_TTL_SECONDS=60

# --- Misc ---
REQUEST_PAYLOAD_RETENTION_DAYS=30      # см. CEO 29.04: храним всегда (вариант C), но с TTL

# --- ЮKassa ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=               # секрет HMAC для подписи входящих webhook
YOOKASSA_RETURN_URL_TEMPLATE=https://brikko.ru/billing/return?account={account_id}
YOOKASSA_BASE_URL=https://api.yookassa.ru/v3

# --- Самозанятый («Мой налог») fallback ---
NPD_ENABLED=true
NPD_INN=                               # ИНН самозанятого CEO/основателя
NPD_PASSWORD=                          # пароль кабинета НПД на lknpd.nalog.ru

# --- Autorefill ---
AUTOREFILL_ENABLED=true
AUTOREFILL_INTERVAL_SECONDS=300        # 5 минут

# --- Management API auth (cookies + JWT + signed tokens) ---
# Generate strong secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET signs cookie-based access/refresh tokens. The validator in
# config.py refuses staging/production boots if this contains "dev",
# "change", "default", "test", "example", "placeholder", or "todo" — or
# is shorter than 32 bytes.
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Pepper for HMAC-SHA256 of single-use tokens (email verify, password reset)
# stored at rest in the DB. Same strength rules as JWT_SECRET. May be empty
# in local/test/development — the implementation falls back to JWT_SECRET.
# REQUIRED in staging/production.
EMAIL_TOKEN_SECRET=

# Cookie Secure flag. Leave unset to derive from APP_ENV:
#   local/test/development → false (HTTP localhost)
#   staging/production    → true  (HTTPS)
# An explicit value (true/false) overrides the default.
COOKIE_DOMAIN=.brikko.ru
# COOKIE_SECURE=true

# Comma-separated allowlist for CORSMiddleware. credentials=true.
CORS_ORIGINS=https://brikko.ru,http://localhost:3000

EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# --- Email outbound ---
# console (default in local) prints to stdout; smtp uses aiosmtplib STARTTLS.
EMAIL_BACKEND=console                  # console | smtp
EMAIL_FROM=no-reply@brikko.ru
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# Used to build {link} in verification / reset emails.
BASE_URL_FRONTEND=http://localhost:3000

# --- Auth rate limits (in-memory, single-process) ---
SIGNUP_RATE_PER_MINUTE=5
LOGIN_RATE_PER_MINUTE=5
FORGOT_RATE_PER_HOUR=3
ACCEPT_INVITE_RATE_PER_HOUR=5         # /v1/account/seats/accept is anonymous

# --- Seats / invites ---
INVITE_TTL_DAYS=7                     # email_invites.expires_at = now + N days

# ----- OAuth (Brikko Studio onboarding) -----
OAUTH_STUDIO_REDIRECT_URIS=http://localhost:3737/callback
OAUTH_ACCESS_TTL_MINUTES=15
OAUTH_REFRESH_TTL_DAYS=30
OAUTH_CODE_TTL_SECONDS=600

# ----- OAuth social login (Google + Yandex) -----
# Brikko is the *client* in this flow: we redirect users to
# accounts.google.com / oauth.yandex.ru and exchange the returned
# code. Empty values disable the corresponding provider (the
# /v1/auth/oauth/{provider}/start endpoint returns 503).
#
# Register the redirect URI exactly as
#   https://api.brikko.ru/v1/auth/oauth/{google,yandex}/callback
# in each provider's developer console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
# Public origin used to assemble redirect URIs. Must NOT carry a
# trailing slash. Production: https://api.brikko.ru
OAUTH_LOGIN_REDIRECT_BASE=http://localhost:8000
OAUTH_LOGIN_STATE_TTL_SECONDS=600
OAUTH_LOGIN_HTTP_TIMEOUT_SECONDS=10
