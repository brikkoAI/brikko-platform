[Unit]
Description=Brikko — subscription failed-renewal retry + downgrade (every 6 h)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/brikko
ExecStart=/usr/bin/docker exec brikko-gateway \
    python -m voltari_gateway.scripts.cron_renewal --job=retry
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30min
