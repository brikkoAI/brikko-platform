# /opt/brikko/.env — production environment for Reg.ru VPS
# Создаётся скриптом bootstrap_env.sh на сервере.
# НЕ коммитить заполненную копию!

ENVIRONMENT=production
RELEASE_TAG=v0.1.0
IMAGE_TAG=v0.1.0
LOG_LEVEL=info
SECRET_KEY=__GENERATE_ON_SERVER__

# PostgreSQL
POSTGRES_DB=brikko
POSTGRES_USER=brikko
POSTGRES_PASSWORD=__GENERATE_ON_SERVER__

# Redis
REDIS_PASSWORD=__GENERATE_ON_SERVER__

# LLM провайдеры (заполняет CEO позже через ssh: nano /opt/brikko/.env)
OPENAI_API_KEY=
OPENAI_ORG_ID=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
GIGACHAT_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_SCOPE=GIGACHAT_API_CORP

# Биллинг — ЮKassa (заполняет CEO позже)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# Бэкапы — Selectel S3 (заполняет CEO позже)
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
BACKUP_BUCKET=brikko-backups-pg

# Sentry (опционально, пусто = выключен)
SENTRY_DSN_GATEWAY=
SENTRY_DSN_WEB=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0
METRICS_ENABLED=true

# Telegram bot
TELEGRAM_BOT_TOKEN=8742854198:AAGN62Km3dIeTVoyoKstQDSwvCTZPZB43UM
TELEGRAM_BOT_USERNAME=BrikkoAI_bot
TELEGRAM_WEBHOOK_SECRET=__GENERATE_ON_SERVER__

# Алерты в TG (заполняет CEO позже — chat_id группы)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Grafana Cloud / Loki (опционально, пока не настроено)
GRAFANA_CLOUD_USERNAME=
GRAFANA_CLOUD_API_KEY=
GRAFANA_CLOUD_PROM_URL=
LOKI_URL=
LOKI_TENANT_ID=
LOKI_API_KEY=
