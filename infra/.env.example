# /opt/voltari/.env — production environment variables for Brikko MVP.
#
# КАК ИСПОЛЬЗОВАТЬ:
#   1. Скопируй: cp .env.example .env
#   2. Заполни значения (НЕ оставляй CHANGE_ME)
#   3. chmod 600 .env && chown deploy:deploy .env
#   4. .env в git НЕ попадает (см. .gitignore)
#
# СЕКРЕТЫ:
#   - Мастер-копия в 1Password vault "Brikko Production"
#   - Бумажная копия мастер-пароля 1Password — в сейфе у CEO
#   - Никогда не отправляй .env в чаты, email, Slack

# ═══════════════════════════════════════════════════════════════════
# Общие
# ═══════════════════════════════════════════════════════════════════

ENVIRONMENT=production                         # production | staging | development
RELEASE_TAG=v0.1.0                             # Текущий тег деплоя — переписывается deploy.yml-ом
# IMAGE_TAG: immutable release tag. НЕ ставить latest — это сломает rollback
# (старый IMAGE_TAG=v0.1.0 не будет восстанавливаемым, ghcr может удалить
#  тег если все pull-and-replace операции переписывают latest на свежий).
# CI/CD сам перезаписывает значение на v* при деплое.
IMAGE_TAG=v0.1.0
LOG_LEVEL=info                                 # debug | info | warn | error
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS           # App-секрет для JWT/CSRF. Сгенерь: openssl rand -hex 32

# ═══════════════════════════════════════════════════════════════════
# PostgreSQL (внутри docker-compose, доступен только из backend-net)
# ═══════════════════════════════════════════════════════════════════

POSTGRES_DB=voltari
POSTGRES_USER=voltari
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD    # openssl rand -base64 32
# Полная DSN — собирается gateway-ом из POSTGRES_* (см. docker-compose.yml)

# ═══════════════════════════════════════════════════════════════════
# Redis (внутри docker-compose)
# ═══════════════════════════════════════════════════════════════════

REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD       # openssl rand -base64 32

# ═══════════════════════════════════════════════════════════════════
# LLM-провайдеры — ключи API
# ═══════════════════════════════════════════════════════════════════

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_ORG_ID=org-CHANGE_ME                    # опционально, если работаем в org

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Google Gemini — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=CHANGE_ME

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-CHANGE_ME

# YandexGPT — https://console.cloud.yandex.ru/folders/.../service-accounts
YANDEX_API_KEY=CHANGE_ME
YANDEX_FOLDER_ID=CHANGE_ME

# Sber GigaChat — https://developers.sber.ru/studio/workspaces
GIGACHAT_API_KEY=CHANGE_ME
GIGACHAT_CLIENT_ID=CHANGE_ME
GIGACHAT_SCOPE=GIGACHAT_API_CORP               # GIGACHAT_API_CORP | GIGACHAT_API_PERS

# ═══════════════════════════════════════════════════════════════════
# Биллинг — ЮKassa (РФ-эквайринг)
# ═══════════════════════════════════════════════════════════════════

# https://yookassa.ru/my/merchant/integration/api-settings
YOOKASSA_SHOP_ID=CHANGE_ME
YOOKASSA_SECRET_KEY=live_CHANGE_ME             # для прода; для теста — test_*
YOOKASSA_WEBHOOK_SECRET=CHANGE_ME              # секрет для верификации webhook'ов

# ═══════════════════════════════════════════════════════════════════
# Бэкапы — Selectel Object Storage (S3-совместимое)
# ═══════════════════════════════════════════════════════════════════

# Создать в ЛК Selectel: Object Storage → бакет → access keys
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
BACKUP_BUCKET=voltari-backups-pg
# AWS-стиль креды используются awscli (хранятся в ~/.aws/credentials, НЕ в .env)
# AWS_ACCESS_KEY_ID и AWS_SECRET_ACCESS_KEY — в /home/deploy/.aws/credentials

# ═══════════════════════════════════════════════════════════════════
# Sentry — мониторинг ошибок
# ═══════════════════════════════════════════════════════════════════

# https://sentry.io/settings/voltari/projects/voltari-gateway/keys/
# Пустая строка = Sentry выключен (для local/staging без DSN).
SENTRY_DSN_GATEWAY=https://CHANGE_ME@oXXX.ingest.sentry.io/PROJECT_ID
SENTRY_DSN_WEB=https://CHANGE_ME@oXXX.ingest.sentry.io/PROJECT_ID
# Performance traces sample rate (0.0..1.0). На free-tier Sentry Developer
# (5k events/мес) — 0.05 хватает для baseline'а. Поднять до 0.2 при
# исследовании конкретного incident'а.
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Prometheus /metrics endpoint. true в production/staging, false в local/test.
# В compose читается gateway-ом и mount'ит /metrics. Доступ к metrics закрыт
# в Caddyfile — наружу не торчит.
METRICS_ENABLED=true

# ═══════════════════════════════════════════════════════════════════
# Telegram — алерты и нотификации
# ═══════════════════════════════════════════════════════════════════

# @BotFather → /newbot → token
TG_BOT_TOKEN=CHANGE_ME:AAAA-CHANGE_ME
# Chat ID группы Brikko Alerts (отрицательное число для групп)
TG_CHAT_ID=-1001234567890

# ═══════════════════════════════════════════════════════════════════
# Grafana Cloud — метрики (Prometheus remote_write)
# ═══════════════════════════════════════════════════════════════════

GRAFANA_CLOUD_USERNAME=CHANGE_ME               # numeric ID из Grafana Cloud
GRAFANA_CLOUD_API_KEY=glc_CHANGE_ME            # API key с правами `metrics:write`
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX.grafana.net/api/prom/push

# ═══════════════════════════════════════════════════════════════════
# Loki — log aggregation (Grafana Cloud Free, 50 GB/mo) — TD-016
# ═══════════════════════════════════════════════════════════════════
#
# Путь получения:
#   1. Grafana Cloud → Connections → Add new → Loki
#   2. Создать stack (бесплатно один на аккаунт)
#   3. В разделе "Send Logs" → выбрать Promtail → скопировать значения
#
# Включить шипинг логов на VPS:
#   docker compose --profile logs up -d promtail
#
# Проверить:
#   В Grafana Cloud → Explore → datasource "grafanacloud-logs" → запрос:
#   {app="voltari", service="gateway"} | json | level="error"

LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
LOKI_TENANT_ID=CHANGE_ME                       # numeric ID из Grafana Cloud
LOKI_API_KEY=glc_CHANGE_ME                     # API key с правами `logs:write`
PROMTAIL_HOSTNAME=voltari-prod-vps             # человекочитаемый ID хоста для логов

# ═══════════════════════════════════════════════════════════════════
# Email (для transactional — регистрация, письма со счетами)
# ═══════════════════════════════════════════════════════════════════

# Yandex 360 SMTP — РФ, 152-ФЗ
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@brikko.ru
SMTP_PASSWORD=CHANGE_ME                        # app-password из Яндекс Паспорта
SMTP_FROM="Brikko <noreply@brikko.ru>"

# ═══════════════════════════════════════════════════════════════════
# Web (Next.js) — публичные переменные
# ═══════════════════════════════════════════════════════════════════

# ВАЖНО: NEXT_PUBLIC_* запекаются в JS-bundle на build time (см. apps/web/Dockerfile),
# поэтому повторно задаются как build-args в .github/workflows/deploy.yml
# и в infra/docker-compose.yml. Эти значения здесь — только для runtime override
# и должны совпадать с build-args. Не используй ${VAR}-подстановки —
# docker-compose разворачивает их из .env, но в build-time они недоступны.
NEXT_PUBLIC_API_BASE_URL=https://api.brikko.ru/v1
NEXT_PUBLIC_FRONTEND_URL=https://brikko.ru
NEXT_PUBLIC_BRAND_NAME=Brikko
NEXT_PUBLIC_AUTH_MIDDLEWARE_DISABLED=false
# Sentry DSN для фронта (PUBLIC по дизайну Sentry — не секрет).
# Дублирует SENTRY_DSN_WEB; синхронизируй вручную при ротации.
NEXT_PUBLIC_SENTRY_DSN=

# ═══════════════════════════════════════════════════════════════════
# Feature flags / behavior
# ═══════════════════════════════════════════════════════════════════

# Принудительный роутинг (для инцидентов — обходим smart-router)
# Например при падении OpenAI: FORCE_ROUTE=anthropic
# Оставить пустым в нормальном режиме.
FORCE_ROUTE=

# Welcome-бонус новому пользователю (₽)
WELCOME_BONUS_RUB=200

# Маржа поверх COGS провайдера (15% в MVP)
PROVIDER_MARKUP=0.15

# Курс USD/RUB (зафиксирован в финмодели; обновляется вручную)
USD_RUB_RATE=80

# ═══════════════════════════════════════════════════════════════════
# Outbound proxy (двухсерверная архитектура — Sprint 8)
# ═══════════════════════════════════════════════════════════════════
#
# OUTBOUND_HTTP_PROXY — base URL зарубежного proxy (Hetzner CX22 в Helsinki),
# доступный через WireGuard tunnel. Gateway проксирует через него вызовы к
# OpenAI/Anthropic/Google. Yandex/Sber/DeepSeek/GigaChat — напрямую из РФ.
#
# Формат запросов от gateway:
#   POST {OUTBOUND_HTTP_PROXY}/openai/v1/chat/completions
#   POST {OUTBOUND_HTTP_PROXY}/anthropic/v1/messages
#   POST {OUTBOUND_HTTP_PROXY}/google/v1beta/models/...:generateContent
#
# В local/staging оставить пустым — gateway тогда ходит к провайдерам напрямую.
# В production обязательно задать (иначе 152-ФЗ не соблюдён + риск блокировки).
#
# См. infra/two_server_setup.md и infra/wireguard_setup.md.

OUTBOUND_HTTP_PROXY=                            # production: http://10.10.0.1:8080
HETZNER_TUNNEL_IP=10.10.0.1                     # tunnel IP Hetzner-сервера
PROXIED_PROVIDERS=openai,anthropic,google       # comma-separated, через proxy
                                                 # Yandex/Sber/DeepSeek/GigaChat — direct

# ═══════════════════════════════════════════════════════════════════
# Telegram bot (получить через @BotFather)
# ═══════════════════════════════════════════════════════════════════

# Токен от @BotFather (формат: 1234567890:ABC...)
TELEGRAM_BOT_TOKEN=
# Username бота без @ (например VoltariBot)
TELEGRAM_BOT_USERNAME=
# Secret для проверки X-Telegram-Bot-Api-Secret-Token (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
