# SOPS-encrypted environment file — пример (не зашифрован).
#
# Этот файл — шаблон. Реальный production-файл `infra/.env.sops.yaml` создаётся так:
#
#   1. Установить SOPS + age:
#        # macOS:    brew install sops age
#        # Linux:    apt install age && curl -L https://github.com/getsops/sops/releases/download/v3.9.1/sops-v3.9.1.linux.amd64 -o /usr/local/bin/sops && chmod +x /usr/local/bin/sops
#        # Windows:  scoop install sops age   (или choco install sops)
#
#   2. Сгенерировать age ключевую пару (один раз на маинтейнера):
#        mkdir -p ~/.config/sops/age
#        age-keygen -o ~/.config/sops/age/keys.txt
#        cat ~/.config/sops/age/keys.txt
#        # Скопировать строку `# public key: age1...` — её положить в .sops.yaml → age:
#
#   3. Скопировать infra/.env.example → infra/.env.sops.yaml.plain (временный, не коммитить!):
#        cp infra/.env.example infra/.env.sops.yaml.plain
#        # Заполнить реальными секретами
#
#   4. Зашифровать через SOPS:
#        sops -e infra/.env.sops.yaml.plain > infra/.env.sops.yaml
#        rm infra/.env.sops.yaml.plain
#
#   5. Закоммитить infra/.env.sops.yaml (зашифрованный, безопасно):
#        git add infra/.env.sops.yaml .sops.yaml
#        git commit -m "Add SOPS-encrypted env"
#
#   6. На VPS / в CI расшифровка:
#        export SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt
#        sops -d infra/.env.sops.yaml > infra/.env
#        chmod 600 infra/.env
#
# Структура файла — обычные key=value пары как в .env, но в YAML-синтаксисе
# (SOPS работает с YAML, JSON, INI, ENV). Мы используем YAML — лучше для
# многострочных секретов.

# ═══════════════════════════════════════════════════════════════════
# Общие
# ═══════════════════════════════════════════════════════════════════
ENVIRONMENT: production
RELEASE_TAG: v0.1.0
IMAGE_TAG: v0.1.0
LOG_LEVEL: info
SECRET_KEY: REPLACE_WITH_RANDOM_64_CHARS

# ═══════════════════════════════════════════════════════════════════
# PostgreSQL
# ═══════════════════════════════════════════════════════════════════
POSTGRES_DB: voltari
POSTGRES_USER: voltari
POSTGRES_PASSWORD: REPLACE_WITH_STRONG_PASSWORD

# ═══════════════════════════════════════════════════════════════════
# Redis
# ═══════════════════════════════════════════════════════════════════
REDIS_PASSWORD: REPLACE_WITH_STRONG_PASSWORD

# ═══════════════════════════════════════════════════════════════════
# LLM-провайдеры
# ═══════════════════════════════════════════════════════════════════
OPENAI_API_KEY: sk-REPLACE_ME
ANTHROPIC_API_KEY: sk-ant-REPLACE_ME
GOOGLE_API_KEY: REPLACE_ME
DEEPSEEK_API_KEY: sk-REPLACE_ME
YANDEX_API_KEY: REPLACE_ME
YANDEX_FOLDER_ID: REPLACE_ME
GIGACHAT_API_KEY: REPLACE_ME
GIGACHAT_CLIENT_ID: REPLACE_ME
GIGACHAT_SCOPE: GIGACHAT_API_CORP

# ═══════════════════════════════════════════════════════════════════
# Биллинг
# ═══════════════════════════════════════════════════════════════════
YOOKASSA_SHOP_ID: REPLACE_ME
YOOKASSA_SECRET_KEY: live_REPLACE_ME
YOOKASSA_WEBHOOK_SECRET: REPLACE_ME

# ═══════════════════════════════════════════════════════════════════
# Sentry / Telegram / Grafana
# ═══════════════════════════════════════════════════════════════════
SENTRY_DSN_GATEWAY: https://REPLACE@oXXX.ingest.sentry.io/PROJECT_ID
SENTRY_DSN_WEB: https://REPLACE@oXXX.ingest.sentry.io/PROJECT_ID
TG_BOT_TOKEN: 'REPLACE:AAAA-REPLACE'
TG_CHAT_ID: '-1001234567890'
GRAFANA_CLOUD_USERNAME: REPLACE_ME
GRAFANA_CLOUD_API_KEY: glc_REPLACE_ME
GRAFANA_CLOUD_PROM_URL: https://prometheus-prod-XX.grafana.net/api/prom/push
LOKI_URL: https://logs-prod-XX.grafana.net/loki/api/v1/push
LOKI_TENANT_ID: REPLACE_ME
LOKI_API_KEY: glc_REPLACE_ME
PROMTAIL_HOSTNAME: voltari-prod-vps

# ═══════════════════════════════════════════════════════════════════
# Email
# ═══════════════════════════════════════════════════════════════════
SMTP_HOST: smtp.yandex.ru
SMTP_PORT: '465'
SMTP_USER: noreply@brikko.ru
SMTP_PASSWORD: REPLACE_ME
SMTP_FROM: 'Brikko <noreply@brikko.ru>'

# ═══════════════════════════════════════════════════════════════════
# Web
# ═══════════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_BASE_URL: https://api.brikko.ru/v1
NEXT_PUBLIC_FRONTEND_URL: https://brikko.ru
NEXT_PUBLIC_BRAND_NAME: Brikko
NEXT_PUBLIC_AUTH_MIDDLEWARE_DISABLED: 'false'
NEXT_PUBLIC_SENTRY_DSN: ''

# ═══════════════════════════════════════════════════════════════════
# Feature flags
# ═══════════════════════════════════════════════════════════════════
FORCE_ROUTE: ''
WELCOME_BONUS_RUB: '200'
PROVIDER_MARKUP: '0.15'
USD_RUB_RATE: '80'
